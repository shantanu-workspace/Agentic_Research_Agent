// Research Assistant Agent — Database Schema
// DB: PostgreSQL (Neon, free tier)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A single research query submitted by a user (or anonymous session).
model Query {
  id               String   @id @default(cuid())
  rawQuery         String
  expandedKeywords Json     // string[] of alternate search phrasings generated by planQuery()
  status           String   @default("pending") // pending | running | complete | error
  errorMessage     String?
  createdAt        DateTime @default(now())
  completedAt      DateTime?

  results QueryResult[]

  @@index([createdAt])
}

/// A paper fetched from Semantic Scholar. Cached globally — shared across queries
/// so repeat lookups (e.g. a popular paper showing up for many queries) don't
/// re-hit the external API or re-cost an LLM call for facts that don't change.
model Paper {
  id             String   @id // Semantic Scholar paperId
  title          String
  abstract       String?
  authors        Json     // [{ name: string }]
  year           Int?
  venue          String?
  citationCount  Int      @default(0)
  url            String?
  tldr           String?
  externalIds    Json?    // { DOI, ArXiv, ... }
  fetchedAt      DateTime @default(now())

  results QueryResult[]

  @@index([citationCount])
}

/// The result of running one paper through the analysis+ranking pipeline
/// for one specific query. This is what the LLM actually produces per-query,
/// and it's what gets cached/returned to the frontend.
model QueryResult {
  id              String  @id @default(cuid())
  queryId         String
  paperId         String
  relevanceScore  Int     // 0-100, from LLM judgment
  qualityScore    Float   // derived from citations + recency
  finalScore      Float   // weighted combination, used for ranking
  llmSummary      String  // contribution + method, in plain language
  llmRationale    String  // why this paper is/isn't relevant to the query
  rank            Int     // 1-indexed position in the final ranked list

  query Query @relation(fields: [queryId], references: [id], onDelete: Cascade)
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([queryId, paperId])
  @@index([queryId, rank])
}
